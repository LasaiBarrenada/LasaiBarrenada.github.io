@online{barrenadaFundamentalProblemRisk2025a,
  title = {The Fundamental Problem of Risk Prediction for Individuals: Health {{AI}}, Uncertainty, and Personalized Medicine},
  shorttitle = {The Fundamental Problem of Risk Prediction for Individuals},
  author = {Barreñada, Lasai and Steyerberg, Ewout W. and Timmerman, Dirk and Thomassen, Doranne and Wynants, Laure and Calster, Ben Van},
  date = {2025-06-20},
  eprint = {2506.17141},
  eprinttype = {arXiv},
  eprintclass = {stat},
  doi = {10.48550/arXiv.2506.17141},
  url = {http://arxiv.org/abs/2506.17141},
  urldate = {2025-07-28},
  abstract = {Background: Clinical prediction models for a health condition are commonly evaluated regarding performance for a population, although decisions are made for individuals. The classic view relates uncertainty in risk estimates for individuals to sample size (estimation uncertainty) but uncertainty can also be caused by model uncertainty (variability in modeling choices) and applicability uncertainty (variability in measurement procedures and between populations). Methods: We used real and synthetic data for ovarian cancer diagnosis to train 59400 models with variations in estimation, model, and applicability uncertainty. We then used these models to estimate the probability of ovarian cancer in a fixed test set of 100 patients and evaluate the variability in individual estimates. Findings: We show empirically that estimation uncertainty can be strongly dominated by model uncertainty and applicability uncertainty, even for models that perform well at the population level. Estimation uncertainty decreased considerably with increasing training sample size, whereas model and applicability uncertainty remained large. Interpretation: Individual risk estimates are far more uncertain than often assumed. Model uncertainty and applicability uncertainty usually remain invisible when prediction models or algorithms are based on a single study. Predictive algorithms should inform, not dictate, care and support personalization through clinician-patient interaction rather than through inherently uncertain model outputs. Funding: This research is supported by Research Foundation Flanders (FWO) grants G097322N, G049312N, G0B4716N, and 12F3114N to BVC and/or DTi, KU Leuven internal grants C24M/20/064 and C24/15/037 to BVC and/or DT, ZoNMW VIDI grant 09150172310023 to LW. DT is a senior clinical investigator of FWO.},
  pubstate = {prepublished},
  keywords = {Statistics - Methodology},
  file = {C\:\\Users\\u0158158\\Zotero\\storage\\JYZ9LBLM\\Barreñada et al. - 2025 - The fundamental problem of risk prediction for individuals health AI, uncertainty, and personalized.pdf;C\:\\Users\\u0158158\\Zotero\\storage\\CAN7LEEM\\2506.html}
}

@article{barrenadaUpdateADNEXRisk2026,
  title = {Update of the {{ADNEX}} Risk Model ({{ADNEX2}}) to Diagnose Ovarian Cancer in Surgically and Conservatively Managed Patients with an Adnexal Mass: Multicentre Prospective Cohort Study},
  shorttitle = {Update of the {{ADNEX}} Risk Model ({{ADNEX2}}) to Diagnose Ovarian Cancer in Surgically and Conservatively Managed Patients with an Adnexal Mass},
  author = {Barreñada, L. and Froyman, Wouter and Ceusters, Jolien and Landolfo, Chiara and Wynants, Laure and Ledger, Ashleigh and Sladkevicius, Povilas and Testa, Antonia C. and Holsbeke, Caroline Van and Buonomo, Francesca and Kudla, Marek J. and Fruscio, Robert and Fischerova, Daniela and Franchi, Dorella and Epstein, Elisabeth and Chiappa, Valentina and Leone, Francesco PG and Ensor, Joie and Coccia, Maria Elisabetta and Guerriero, Stefano and Alcazar, Juan Luis and Alves, Fatima and Jokubkiene, Ligita and Pozzati, Federica and Moro, Francesca and Mascilini, Floriana and Taliento, Cristina and Bourne, Tom and Valentin, Lil and Timmerman, Dirk and Calster, Ben Van},
  date = {2026-10-26},
  journaltitle = {medRxiv},
  pages = {2026.10.23.26365247},
  publisher = {Cold Spring Harbor Laboratory Press},
  issn = {3067-2007},
  doi = {10.64898/2026.10.23.26365247},
  url = {https://www.medrxiv.org/content/10.64898/2026.10.23.26365247v1},
  urldate = {2026-10-26},
  abstract = {{$<$}p{$>$}Objective: The ADNEX ultrasound-based prediction model estimates the probability that an adnexal mass is benign, borderline, stage I primary invasive, stage II-IV primary invasive, or secondary metastatic. ADNEX was developed on patients managed surgically. We aimed to update ADNEX to ADNEX2 using more recent data on both surgically and conservatively managed patients. ADNEX2 is designed for use in patients in whom the benign descriptors (BDs), a set of ultrasound profiles with an estimated risk of malignancy below 1\%, do not apply. Design: Secondary analysis of a multicentre prospective cohort study. Setting: 17 oncology and non-oncology centres from 8 European countries. Participants: Patients with a newly detected adnexal mass recruited between 2012 and 2016 who were managed surgically or conservatively with clinical and ultrasound follow-up. Interventions: ADNEX2 uses the same predictors as ADNEX (age, type of centre, lesion diameter, proportion of solid tissue, number of papillary projections, \&gt;10 cyst locules, ascites and acoustic shadows and CA125). Model updating involved logistic recalibration followed by Bayesian refitting. Validation was based on leave-one-centre-out cross-validation. ADNEX2 and ADNEX include CA125 but also work without CA125. Main outcome measures: Model performance regarding discrimination (AUC), calibration (plots and observed:expected, O:E, ratio), and clinical utility (net benefit). Results: Of 6847 patients, 4625 (68\%) had a benign tumour, 1710 (25\%) had a malignant tumour, while tumour outcome was uncertain for 512 (7\%) patients. BDs applied in 2190 (32\%) patients, of whom 0.5\% (95\% CI, 0.2\%-0.9\%) had a malignancy. A two-step strategy using BDs followed by ADNEX2 had an AUC of 0.95 (0.94-0.96) to distinguish benign from malignant tumours. When evaluated on 4657 patients in whom BDs did not apply, ADNEX2 had an AUC of 0.93 (0.91-0.94). The two-step strategy with ADNEX2 was better calibrated than the two-step strategy with ADNEX (O:E ratio of 1.05 versus 1.14) and had marginally higher clinical utility. Not including available CA125 values in ADNEX2 reduced the ability to distinguish stage II-IV primary invasive tumours from other invasive malignancies. Conclusions: ADNEX2 is better calibrated than ADNEX. CA125 measurement is not crucial to estimate the risk of malignancy, but is recommended to estimate the risk of malignant subtypes. Trial registration: clinicaltrials.gov NCT01698632.{$<$}/p{$>$}},
  langid = {english},
  file = {C:\Users\u0158158\Zotero\storage\EKHWMVNX\Barreñada et al. - 2026 - Update of the ADNEX risk model (ADNEX2) to diagnose ovarian cancer in surgically and conservatively.pdf}
}

@article{ensorSystemIndependentEvaluation2026a,
  title = {A System for Independent Evaluation of Clinical Prediction Models While Preserving Intellectual Property and Data Privacy},
  author = {Ensor, Joie and Van Calster, Ben and Barreñada, Lasai and Wynants, Laure and Perry, Benjamin I.},
  date = {2026-06-15},
  publisher = {Zenodo},
  doi = {10.5281/zenodo.20707722},
  url = {https://zenodo.org/records/20707722},
  urldate = {2026-08-11},
  abstract = {Evaluating clinical prediction models (CPMs) in new patients and settings is essential for building the evidence needed to support their adoption in practice. Independent evaluation by researchers distinct from the CPM developers is particularly valued, yet remains underutilised due to barriers of data access, governance, and technical complexity. Here we propose a novel two-component system enabling any researcher to conduct a fully independent evaluation of a static CPM, with no requirement to share patient data, no specialist infrastructure, and minimal code. The system lowers the barrier to evaluation while providing developers with confidence that CPMs are evaluated exactly as intended. The system also resolves a growing tension between open science and commercial viability: model parameters remain under the developer's control and are protected throughout, preserving intellectual property while enabling evaluation to proceed. We introduce evaluatr, a free R package that implements the workflow. The proposed system provides a viable pathway toward widespread evaluation and ultimately impact for promising CPMs, where few routes currently exist.},
  file = {C:\Users\u0158158\Zotero\storage\A88FZ2DP\Ensor et al. - 2026 - A system for independent evaluation of clinical prediction models while preserving intellectual prop.pdf}
}

@online{gorgelsOptimizingDecisionNot2026,
  title = {Optimizing for the Decision Not the Prediction: An Exploration of {{Smooth Net Benefit}} as a Training Objective},
  shorttitle = {Optimizing for the Decision Not the Prediction},
  author = {Gorgels, Koen M. F. and Barreñada, Lasai and family=Smeden, given=Maarten, prefix=van, useprefix=false and Calster, Ben Van and Steyerberg, Ewout W. and family=Amsterdam, given=Wouter A. C., prefix=van, useprefix=false},
  date = {2026-09-11},
  eprint = {2609.12752},
  eprinttype = {arXiv},
  eprintclass = {cs.LG},
  doi = {10.48550/arXiv.2609.12752},
  url = {http://arxiv.org/abs/2609.12752},
  urldate = {2026-10-14},
  abstract = {Objective Prediction models are commonly trained using objectives such as Bernoulli negative log-likelihood (NLL), although downstream clinical decisions may depend on specific risk thresholds. We introduce Smooth Net Benefit (\$σ\$NB), a differentiable approximation of Net Benefit designed to align model training with threshold-specific clinical utility. Materials and Methods We evaluated \$σ\$NB as a training objective for logistic regression, generalized additive models (GAMs), and XGBoost with three Hessian implementations. Experiments used the Framingham cardiovascular risk dataset and 44 TabZilla datasets comprising 72 dataset-threshold combinations. Results \$σ\$NB training did not consistently improve Net Benefit in Framingham. Across the TabZilla benchmark, mean standardized Net Benefit for logistic regression increased from 0.5669 with NLL to 0.5765 with \$σ\$NB (mean difference 0.0096, 95\% CI -0.0001 to 0.0193). For GAMs, mean standardized Net Benefit decreased from 0.5921 to 0.5625 (mean difference -0.0296, 95\% CI -0.0721 to 0.0129). For XGBoost, NLL achieved 0.6745 compared with 0.6723--0.6735 across \$σ\$NB implementations. In logistic regression, \$σ\$NB gains were positively associated with the performance advantage of XGBoost over NLL-trained logistic regression. Discussion The effect of \$σ\$NB was context dependent, with modest gains concentrated in logistic regression and little benefit for more flexible model classes. This suggests that decision-focused optimization may be most useful when limited model flexibility leaves greater scope for improvement. Conclusion Our results do not support \$σ\$NB as a general replacement for NLL training, but support further investigation of decision-focused objectives in settings where conventional likelihood-based training may not adequately capture decision-relevant structure.},
  pubstate = {prepublished},
  keywords = {Computer Science - Machine Learning},
  file = {C\:\\Users\\u0158158\\Zotero\\storage\\ASKNNSYR\\Gorgels et al. - 2026 - Optimizing for the decision not the prediction an exploration of Smooth Net Benefit as a training o.pdf;C\:\\Users\\u0158158\\Zotero\\storage\\6TWUR2KQ\\2609.html}
}

@report{martinez-garciaClinicalSeverityPrediction2023,
  type = {preprint},
  title = {Clinical Severity Prediction of {{COVID-19}} Admitted Patients in {{Spain}}: {{SEMI}} and {{REDISSEC}} Cohorts},
  shorttitle = {Clinical Severity Prediction of {{COVID-19}} Admitted Patients in {{Spain}}},
  author = {Martínez-García, Mario and García-Gutierrez, Susana and Barreñada Taleb, Lasai and Armañanzas, Rubén and Inza, Inaki and Lozano, Jose A.},
  date = {2023-02-10},
  institution = {Health Informatics},
  doi = {10.1101/2023.02.08.23285589},
  url = {http://medrxiv.org/lookup/doi/10.1101/2023.02.08.23285589},
  urldate = {2023-05-28},
  abstract = {This report addresses, from a machine learning perspective, a multi-class classification problem to predict the first deterioration level of a COVID-19 positive patient at the time of hospital admission. Socio-demographic features, laboratory tests and other measures are taken into account to learn the models. Our output is divided into 4 categories ranging from healthy patients, followed by patients requiring some form of ventilation (divided in 2 categories) and finally patients expected to die. The study is conducted thanks to data provided by Sociedad Española de Medicina Interna (SEMI) and Red de Investigación en Servicios de Salud de Enfermedades Crónicas (REDISSEC). Results show that logistic regression is the best method for identifying patients with clinical deterioration.},
  langid = {english},
  file = {C:\Users\u0158158\Zotero\storage\IAWEHJHT\Martínez-García et al. - 2023 - Clinical severity prediction of COVID-19 admitted .pdf}
}

@software{NBvarselVariableSelection2026,
  title = {{{NBvarsel}}: {{Variable Selection}} via {{Cross-Validated Net Benefit}}},
  shorttitle = {{{NBvarsel}}},
  author = {Barreñada, Lasai and Wynants, Laure and Steyerberg, E. W. and Vickers, A.J. and Van Calster, Ben},
  date = {2026-08-30},
  doi = {10.32614/CRAN.package.NBvarsel},
  url = {https://cran.r-project.org/web/packages/NBvarsel/index.html},
  urldate = {2026-09-15},
  abstract = {Performs exhaustive or groupwise (backward elimination) variable selection for binary outcome prediction models using cross-validated Net Benefit as the optimization criterion. It supports predictor costs, restricted cubic splines, interaction terms, permutation importance, and parallel computation. It includes visualizations for model comparison and variable importance. References include Vickers AJ \& Elkin EB (2006) {$<$}doi:10.1177/0272989X06295361{$>$}, Van Calster B et al. (2018) {$<$}doi:10.1016/j.eururo.2018.08.038{$>$}, Vickers AJ et al. (2019) {$<$}doi:10.1186/s41512-019-0064-7{$>$}, and Baker SG et al. (2012) {$<$}doi:10.1515/1557-4679.1395{$>$}.},
  version = {0.1.1}
}
